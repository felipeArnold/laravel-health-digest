{
    "name": "felipearnold/laravel-health-digest",
    "description": "Logs slow queries and slow requests and groups them, together with application errors, into a ranked JSON digest.",
    "keywords": ["laravel", "monitoring", "slow-query", "slow-request", "logging", "digest"],
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Arnold"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/log": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "FelipeArnold\\HealthDigest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FelipeArnold\\HealthDigest\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FelipeArnold\\HealthDigest\\HealthDigestServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
